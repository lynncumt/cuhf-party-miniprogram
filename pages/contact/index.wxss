.top-banner {
  background: linear-gradient(135deg, #8B0000, #CC0000);
  border-radius: 16rpx; padding: 36rpx 30rpx; margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(204,0,0,0.3); text-align: center;
}
.top-title { font-size: 40rpx; font-weight: bold; color: #FFD700; letter-spacing: 4rpx; margin-bottom: 4rpx; }
.top-subtitle { font-size: 40rpx; font-weight: bold; color: #FFD700; letter-spacing: 4rpx; margin-bottom: 16rpx; }
.top-desc { font-size: 26rpx; color: rgba(255,255,255,0.9); }

.form-card {
  background: #fff; border-radius: 16rpx; padding: 28rpx;
  margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.form-section-title { font-size: 28rpx; color: #CC0000; font-weight: bold; margin-bottom: 20rpx; line-height: 1.6; }

.need-category { margin-bottom: 24rpx; }
.cat-header {
  display: flex; align-items: center; gap: 12rpx;
  margin-bottom: 14rpx; padding-bottom: 10rpx;
  border-bottom: 1rpx solid #F5F5F5;
}
.cat-num-badge {
  width: 40rpx; height: 40rpx; border-radius: 50%;
  background: #CC0000; color: #FFD700;
  font-size: 20rpx; font-weight: bold;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.cat-name { font-size: 28rpx; font-weight: bold; color: #333; }

.cat-items { display: grid; grid-template-columns: 1fr 1fr; gap: 10rpx; }

.check-item {
  display: flex; align-items: flex-start; gap: 10rpx;
  padding: 12rpx; border-radius: 8rpx;
  border: 1rpx solid #EEEEEE; background: #FAFAFA;
  transition: all 0.2s;
}
.check-item.checked { background: #FFF5F5; border-color: #FFCCCC; }

.checkbox {
  width: 36rpx; height: 36rpx; border-radius: 6rpx;
  border: 2rpx solid #CCCCCC; background: #fff;
  display: flex; align-items: center; justify-content: center;
  flex-shrink: 0; font-size: 22rpx; color: #fff;
}
.checkbox-checked { background: #CC0000; border-color: #CC0000; }

.check-label { font-size: 24rpx; color: #444; line-height: 1.5; flex: 1; }

/* 表单行 */
.form-row {
  border-bottom: 1rpx solid #F5F5F5; padding: 20rpx 0; display: flex; align-items: center;
}
.form-row:last-child { border-bottom: none; }
.form-row-textarea { flex-direction: column; align-items: flex-start; }

.form-label {
  width: 160rpx; font-size: 28rpx; color: #333; flex-shrink: 0;
  display: flex; align-items: center; gap: 4rpx;
}
.required { color: #CC0000; font-size: 28rpx; }

.form-input {
  flex: 1; font-size: 28rpx; color: #222; height: 60rpx;
}

.picker-view {
  flex: 1; font-size: 28rpx; color: #222; display: flex;
  align-items: center; justify-content: space-between;
  padding-right: 10rpx;
}
.picker-arrow { color: #CCCCCC; font-size: 36rpx; }

.form-textarea {
  width: 100%; height: 180rpx; font-size: 28rpx; color: #222;
  margin-top: 14rpx; line-height: 1.6;
}
.char-count { font-size: 22rpx; color: #AAAAAA; align-self: flex-end; margin-top: 4rpx; }

.submit-btn {
  background: linear-gradient(135deg, #CC0000, #FF3333) !important;
  color: #FFD700 !important; font-size: 34rpx !important; font-weight: bold !important;
  border-radius: 50rpx !important; height: 96rpx !important; line-height: 96rpx !important;
  box-shadow: 0 6rpx 20rpx rgba(204,0,0,0.4) !important;
  margin-bottom: 20rpx !important;
}
.submit-btn.submitting { opacity: 0.7 !important; }
.tip-text { text-align: center; font-size: 24rpx; color: #AAAAAA; margin-bottom: 30rpx; }
