.cases-header {
  background: linear-gradient(135deg, #8B0000, #CC0000);
  border-radius: 16rpx; padding: 30rpx; margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(204,0,0,0.3);
}
.cases-title { font-size: 34rpx; font-weight: bold; color: #FFD700; margin-bottom: 8rpx; }
.cases-desc { font-size: 26rpx; color: rgba(255,255,255,0.85); }

.loading, .empty-tip { text-align: center; padding: 60rpx; color: #999; font-size: 28rpx; }

.case-card {
  background: #fff; border-radius: 16rpx; margin-bottom: 20rpx;
  overflow: hidden; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.case-img { width: 100%; height: 280rpx; object-fit: cover; display: block; }
.case-img-placeholder {
  width: 100%; height: 280rpx;
  background: linear-gradient(135deg, #CC0000 0%, #FF8866 100%);
  display: flex; align-items: center; justify-content: center;
}
.case-img-text { color: #FFD700; font-size: 32rpx; font-weight: bold; }

.case-content { padding: 24rpx; }
.case-title { font-size: 30rpx; font-weight: bold; color: #222; margin-bottom: 12rpx; line-height: 1.5; }
.case-summary { font-size: 26rpx; color: #666; line-height: 1.6; margin-bottom: 16rpx; }

.case-meta { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8rpx; }
.case-date { font-size: 22rpx; color: #999; }
.case-tags { display: flex; flex-wrap: wrap; gap: 8rpx; }
.tag {
  background: #FFF0F0; color: #CC0000; border: 1rpx solid #FFCCCC;
  border-radius: 6rpx; padding: 4rpx 12rpx; font-size: 20rpx;
}

.load-more {
  text-align: center; padding: 24rpx; color: #CC0000;
  font-size: 28rpx; border: 1rpx solid #FFCCCC;
  border-radius: 12rpx; background: #fff; margin-bottom: 20rpx;
}
