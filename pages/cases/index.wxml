<!-- 案例采撷 -->
<view class="container">

  <view class="cases-header">
    <view class="cases-title">校企党建互助案例采撷</view>
    <view class="cases-desc">汇聚校企党建互助优秀实践案例</view>
  </view>

  <view wx:if="{{loading}}" class="loading">加载中...</view>

  <view class="case-list" wx:else>
    <view
      class="case-card"
      wx:for="{{cases}}"
      wx:key="_id"
      bindtap="goToDetail"
      data-id="{{item._id}}"
    >
      <image class="case-img" src="{{item.coverImage || ''}}" mode="aspectFill" wx:if="{{item.coverImage}}"></image>
      <view class="case-img case-img-placeholder" wx:else>
        <text class="case-img-text">党建互助</text>
      </view>
      <view class="case-content">
        <view class="case-title">{{item.title}}</view>
        <view class="case-summary">{{item.summary}}</view>
        <view class="case-meta">
          <text class="case-date">{{item.date}}</text>
          <view class="case-tags">
            <view class="tag" wx:for="{{item.tags}}" wx:key="index" wx:for-item="tag">{{tag}}</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="load-more" wx:if="{{hasMore}}" bindtap="loadMore">加载更多</view>

  <view class="empty-tip" wx:if="{{!loading && cases.length === 0}}">
    <text>暂无案例，敬请期待</text>
  </view>

</view>
