.video-header {
  background: linear-gradient(135deg, #1a1a2e, #16213e);
  border-radius: 16rpx; padding: 30rpx; margin-bottom: 20rpx;
}
.video-title { font-size: 36rpx; font-weight: bold; color: #FFD700; margin-bottom: 8rpx; }
.video-desc { font-size: 26rpx; color: rgba(255,255,255,0.8); }

.current-video-wrap {
  background: #000; border-radius: 16rpx; overflow: hidden;
  margin-bottom: 20rpx; box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.3);
}
.main-video { width: 100%; height: auto; min-height: 400rpx; display: block; }
.current-title {
  background: #111; color: #fff; padding: 16rpx 20rpx;
  font-size: 28rpx; line-height: 1.5;
}

.video-list { }
.video-item {
  background: #fff; border-radius: 12rpx; margin-bottom: 16rpx;
  display: flex; gap: 16rpx; padding: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06); overflow: hidden;
  border: 2rpx solid transparent;
}
.video-item.active { border-color: #CC0000; background: #FFF5F5; }

.video-thumb-wrap {
  width: 200rpx; height: 120rpx; border-radius: 8rpx;
  overflow: hidden; flex-shrink: 0; position: relative;
}
.video-thumb { width: 100%; height: 100%; object-fit: cover; }
.video-thumb-placeholder {
  width: 100%; height: 100%;
  background: linear-gradient(135deg, #1a1a2e, #CC0000);
  display: flex; align-items: center; justify-content: center;
  color: #FFD700; font-size: 48rpx;
}
.play-icon {
  position: absolute; top: 50%; left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(204,0,0,0.8); color: #FFD700;
  width: 50rpx; height: 50rpx; border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx;
}

.video-meta { flex: 1; display: flex; flex-direction: column; justify-content: center; }
.video-name { font-size: 28rpx; color: #222; line-height: 1.5; margin-bottom: 8rpx; }
.video-duration { font-size: 22rpx; color: #999; }

.empty-tip { text-align: center; padding: 60rpx; color: #999; font-size: 28rpx; }
