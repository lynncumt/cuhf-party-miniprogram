<!-- 学校媒体链接 -->
<view class="container">

  <view class="media-header">
    <view class="media-title">学校媒体链接</view>
  </view>

  <view class="media-list">
    <view
      class="media-row"
      wx:for="{{mediaLinks}}"
      wx:key="id"
    >
      <view class="media-name">{{item.name}}</view>
      <view class="media-qr-wrap">
        <image
          class="media-qr-img"
          src="{{item.qrImage}}"
          mode="aspectFit"
          wx:if="{{item.qrImage}}"
          bindtap="previewQr"
          data-url="{{item.qrImage}}"
        ></image>
        <view class="media-qr-placeholder" wx:else>
          <text>二维码</text>
        </view>
      </view>
    </view>
  </view>

  <view class="media-footer">欢迎关注！</view>

</view>
