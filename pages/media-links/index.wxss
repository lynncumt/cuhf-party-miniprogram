.media-header {
  background: linear-gradient(135deg, #8B0000, #CC0000);
  border-radius: 16rpx; padding: 30rpx; margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(204,0,0,0.3);
}
.media-title { font-size: 36rpx; font-weight: bold; color: #FFD700; margin-bottom: 8rpx; }
.media-desc { font-size: 26rpx; color: rgba(255,255,255,0.85); }

.qrcode-card {
  display: flex; align-items: center;
}
.qr-row-name {
  font-size: 30rpx; font-weight: bold; color: #222;
  width: 200rpx; flex-shrink: 0;
}

.qr-img-wrap {
  width: 180rpx; height: 180rpx; flex-shrink: 0;
}
.qr-img { width: 180rpx; height: 180rpx; display: block; }
.qr-img-placeholder {
  width: 180rpx; height: 180rpx; border-radius: 12rpx;
  background: linear-gradient(135deg, #F5F5F5, #EEEEEE);
  border: 2rpx dashed #CCCCCC;
  display: flex; align-items: center; justify-content: center;
  font-size: 24rpx; color: #999;
}
