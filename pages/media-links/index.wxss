.container {
  padding: 30rpx;
}

.media-header {
  padding: 10rpx 0 30rpx;
}
.media-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #222222;
}

.media-list {
  background: #fff;
}

.media-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 20rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.media-row:last-child {
  border-bottom: none;
}

.media-name {
  font-size: 32rpx;
  color: #222222;
}

.media-qr-wrap {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
}

.media-qr-img {
  width: 160rpx;
  height: 160rpx;
  display: block;
}

.media-qr-placeholder {
  width: 160rpx;
  height: 160rpx;
  background: #F5F5F5;
  border: 2rpx dashed #CCCCCC;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #999999;
}

.media-footer {
  text-align: center;
  font-size: 30rpx;
  color: #333333;
  padding: 60rpx 0 30rpx;
}
