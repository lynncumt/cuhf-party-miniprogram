.db-header {
  background: linear-gradient(135deg, #8B0000, #CC0000);
  border-radius: 16rpx; padding: 30rpx; margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(204,0,0,0.3);
}
.db-title { font-size: 36rpx; font-weight: bold; color: #FFD700; margin-bottom: 10rpx; }
.db-subtitle { font-size: 26rpx; color: rgba(255,255,255,0.85); line-height: 1.6; }

.loading { text-align: center; padding: 60rpx; color: #999; font-size: 28rpx; }

.expert-list { }
.expert-card {
  background: #fff; border-radius: 16rpx; padding: 28rpx;
  margin-bottom: 20rpx; display: flex; gap: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  position: relative; overflow: hidden;
}
.expert-card::before {
  content: ''; position: absolute; top: 0; left: 0; right: 0; height: 5rpx;
  background: linear-gradient(90deg, #CC0000, #FF6666);
}

.expert-avatar-wrap { flex-shrink: 0; }
.expert-avatar { width: 120rpx; height: 120rpx; border-radius: 50%; object-fit: cover; }
.expert-avatar-placeholder {
  width: 120rpx; height: 120rpx; border-radius: 50%;
  background: linear-gradient(135deg, #CC0000, #FF4444);
  display: flex; align-items: center; justify-content: center;
  color: #FFD700; font-size: 44rpx; font-weight: bold;
}

.expert-info { flex: 1; }
.expert-name { font-size: 32rpx; font-weight: bold; color: #222; margin-bottom: 6rpx; }
.expert-title { font-size: 24rpx; color: #CC0000; margin-bottom: 10rpx; }
.expert-tags { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 10rpx; }
.tag {
  background: #FFF0F0; color: #CC0000; border: 1rpx solid #FFCCCC;
  border-radius: 6rpx; padding: 4rpx 12rpx; font-size: 20rpx;
}
.expert-intro { font-size: 24rpx; color: #666; line-height: 1.6; }

.load-more {
  text-align: center; padding: 24rpx; color: #CC0000;
  font-size: 28rpx; border: 1rpx solid #FFCCCC;
  border-radius: 12rpx; background: #fff; margin-bottom: 20rpx;
}
