.db-header {
  background: linear-gradient(135deg, #8B0000, #CC0000);
  border-radius: 16rpx; padding: 30rpx; margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(204,0,0,0.3);
}
.db-title { font-size: 36rpx; font-weight: bold; color: #FFD700; margin-bottom: 10rpx; }
.db-subtitle { font-size: 26rpx; color: rgba(255,255,255,0.85); }

.category-section {
  background: #fff; border-radius: 16rpx; margin-bottom: 20rpx; overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.category-header {
  background: linear-gradient(90deg, #CC0000, #FF5555);
  padding: 22rpx 28rpx; display: flex; align-items: center; gap: 14rpx;
}
.cat-num {
  width: 44rpx; height: 44rpx; border-radius: 50%;
  background: rgba(255,215,0,0.3); border: 2rpx solid #FFD700;
  color: #FFD700; font-size: 22rpx; font-weight: bold;
  display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.cat-title { font-size: 30rpx; font-weight: bold; color: #fff; }

.course-list { padding: 12rpx 0; }
.course-item {
  display: flex; align-items: center;
  padding: 18rpx 28rpx; border-bottom: 1rpx solid #F5F5F5;
}
.course-item:last-child { border-bottom: none; }
.course-num { color: #CC0000; font-size: 26rpx; font-weight: bold; margin-right: 10rpx; width: 44rpx; flex-shrink: 0; }
.course-name { flex: 1; font-size: 28rpx; color: #333; line-height: 1.5; }
.course-duration { font-size: 22rpx; color: #999; margin-left: 10rpx; white-space: nowrap; }
