<!-- 校区地址 -->
<view class="container">

  <view class="addr-header">
    <view class="addr-title">📍 校区地址</view>
    <view class="addr-subtitle">合肥城市学院 · 各校区导航</view>
  </view>

  <view class="campus-card" wx:for="{{campuses}}" wx:key="id">
    <view class="campus-name-bar">
      <view class="campus-icon">🏛️</view>
      <view class="campus-name">{{item.name}}</view>
    </view>
    <view class="campus-detail">
      <view class="detail-row">
        <text class="detail-label">地址</text>
        <text class="detail-value">{{item.address}}</text>
      </view>
      <view class="detail-row" wx:if="{{item.postcode}}">
        <text class="detail-label">邮编</text>
        <text class="detail-value">{{item.postcode}}</text>
      </view>
      <view class="detail-row" wx:if="{{item.phone}}">
        <text class="detail-label">电话</text>
        <text class="detail-value phone" data-phone="{{item.phone}}" bindtap="callPhone">{{item.phone}}</text>
      </view>
    </view>
    <view class="nav-btn" bindtap="openMap" data-name="{{item.name}}" data-address="{{item.address}}" data-lat="{{item.lat}}" data-lng="{{item.lng}}">
      <text>🗺️ 高德地图导航</text>
    </view>
  </view>

  <!-- 联系电话 -->
  <view class="card contact-card">
    <view class="contact-title">联系电话</view>
    <view class="phone-list">
      <view class="phone-item" wx:for="{{phones}}" wx:key="index" bindtap="callPhone" data-phone="{{item.number}}">
        <view class="phone-dept">{{item.dept}}</view>
        <view class="phone-num">📞 {{item.number}}</view>
      </view>
    </view>
  </view>

</view>
