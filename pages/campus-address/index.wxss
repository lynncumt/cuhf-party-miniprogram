.addr-header {
  background: linear-gradient(135deg, #8B0000, #CC0000);
  border-radius: 16rpx; padding: 30rpx; margin-bottom: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(204,0,0,0.3);
}
.addr-title { font-size: 36rpx; font-weight: bold; color: #FFD700; margin-bottom: 8rpx; }
.addr-subtitle { font-size: 26rpx; color: rgba(255,255,255,0.85); }

.campus-card {
  background: #fff; border-radius: 16rpx; margin-bottom: 20rpx;
  overflow: hidden; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.campus-name-bar {
  background: linear-gradient(90deg, #CC0000, #FF5555);
  padding: 22rpx 28rpx; display: flex; align-items: center; gap: 14rpx;
}
.campus-icon { font-size: 36rpx; }
.campus-name { font-size: 32rpx; font-weight: bold; color: #fff; }

.campus-detail { padding: 20rpx 28rpx; }
.detail-row { display: flex; align-items: flex-start; padding: 14rpx 0; border-bottom: 1rpx solid #F5F5F5; }
.detail-row:last-child { border-bottom: none; }
.detail-label { width: 80rpx; font-size: 26rpx; color: #999; flex-shrink: 0; }
.detail-value { flex: 1; font-size: 28rpx; color: #333; line-height: 1.6; }
.detail-value.phone { color: #CC0000; text-decoration: underline; }

.nav-btn {
  margin: 0 28rpx 24rpx;
  background: linear-gradient(135deg, #CC0000, #FF4444);
  color: #FFD700; font-size: 28rpx; font-weight: bold;
  text-align: center; padding: 22rpx;
  border-radius: 12rpx; box-shadow: 0 4rpx 12rpx rgba(204,0,0,0.3);
}

.contact-card { background: #fff; border-radius: 16rpx; padding: 28rpx; box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06); margin-bottom: 20rpx; }
.contact-title { font-size: 30rpx; font-weight: bold; color: #CC0000; margin-bottom: 16rpx; padding-bottom: 14rpx; border-bottom: 2rpx solid #FFDDDD; }
.phone-list { }
.phone-item { padding: 18rpx 0; border-bottom: 1rpx solid #F5F5F5; }
.phone-item:last-child { border-bottom: none; }
.phone-dept { font-size: 26rpx; color: #666; margin-bottom: 6rpx; }
.phone-num { font-size: 30rpx; color: #CC0000; font-weight: bold; }
