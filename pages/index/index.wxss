.index-page {
  background: #F5F5F5;
  min-height: 100vh;
}

/* Banner */
.banner-wrap {
  width: 100%;
  height: 300rpx;
  overflow: hidden;
  position: relative;
}

.banner-img {
  width: 100%;
  height: 300rpx;
  display: block;
}

.banner-default {
  width: 100%;
  height: 300rpx;
  background: linear-gradient(135deg, #8B0000 0%, #CC0000 60%, #FF4444 100%);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.banner-logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
}

.banner-logo {
  font-size: 48rpx;
  font-weight: bold;
  color: #FFD700;
  letter-spacing: 4rpx;
}

.banner-logo-en {
  font-size: 20rpx;
  color: rgba(255,255,255,0.8);
  letter-spacing: 2rpx;
  margin-top: 6rpx;
}

.banner-slogan-area {
  padding: 0 30rpx;
}

.banner-slogan {
  font-size: 26rpx;
  color: #ffffff;
  letter-spacing: 2rpx;
  text-align: center;
}

/* 功能导航 */
.module-wrap {
  background: #ffffff;
  margin-bottom: 16rpx;
  padding: 20rpx 16rpx 24rpx;
}

.module-wrap-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
  padding-left: 14rpx;
  border-left: 6rpx solid #CC0000;
  margin-bottom: 20rpx;
}

.module-row {
  display: flex;
  flex-direction: row;
  justify-content: flex-start;
  margin-bottom: 20rpx;
}

.module-row:last-child {
  margin-bottom: 0;
}

.module-item {
  flex: none;
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 0;
}

.module-item-3 {
  flex: none;
  width: 25%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 0;
}

.module-icon-wrap {
  width: 100rpx;
  height: 100rpx;
  border-radius: 20rpx;
  background: #FFF0F0;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}

.module-icon {
  font-size: 52rpx;
  line-height: 1;
}

.module-name {
  font-size: 22rpx;
  color: #333333;
  text-align: center;
  line-height: 1.4;
  word-break: break-all;
}

/* 合城动态 */
.news-section {
  background: #ffffff;
  margin: 0 0 20rpx;
  padding: 0 0 10rpx;
}

.news-section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #CC0000;
  padding: 20rpx 24rpx 16rpx;
  border-bottom: 2rpx solid #FFEEEE;
}

.news-list {
  padding: 0 16rpx;
}

.news-item {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 8rpx;
  border-bottom: 1rpx solid #F0F0F0;
}

.news-item:last-child {
  border-bottom: none;
}

.news-text-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding-right: 16rpx;
}

.news-title {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.news-date {
  font-size: 22rpx;
  color: #999999;
}

.news-img-wrap {
  width: 160rpx;
  height: 110rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
  overflow: hidden;
}

.news-thumb {
  width: 160rpx;
  height: 110rpx;
  display: block;
}

.news-thumb-placeholder {
  width: 160rpx;
  height: 110rpx;
  background: #F0F0F0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.placeholder-text {
  font-size: 28rpx;
  color: #CCCCCC;
}
