.index-page {
  background: #F5F5F5;
  min-height: 100vh;
}

/* Banner */
.banner {
  background: linear-gradient(135deg, #8B0000 0%, #CC0000 50%, #FF4444 100%);
  padding: 40rpx 30rpx 50rpx;
  position: relative;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.banner::before {
  content: '';
  position: absolute;
  top: -40rpx;
  right: -40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: rgba(255,255,255,0.1);
}

.banner-content {
  flex: 1;
}

.banner-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #FFD700;
  margin-bottom: 8rpx;
  text-shadow: 1rpx 1rpx 4rpx rgba(0,0,0,0.3);
}

.banner-subtitle {
  font-size: 30rpx;
  color: #ffffff;
  margin-bottom: 12rpx;
}

.banner-slogan {
  font-size: 22rpx;
  color: rgba(255,255,255,0.85);
  letter-spacing: 2rpx;
}

.banner-emblem {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background: rgba(255,215,0,0.2);
  border: 4rpx solid rgba(255,215,0,0.6);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #FFD700;
  font-weight: bold;
  margin-left: 20rpx;
}

/* 新闻滚动 */
.news-ticker {
  background: #ffffff;
  display: flex;
  align-items: center;
  padding: 0 20rpx;
  height: 72rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.news-ticker-label {
  background: #CC0000;
  color: #FFD700;
  font-size: 24rpx;
  font-weight: bold;
  padding: 6rpx 14rpx;
  border-radius: 6rpx;
  white-space: nowrap;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.news-swiper {
  flex: 1;
  height: 72rpx;
}

.news-swiper-item {
  height: 72rpx;
  line-height: 72rpx;
  font-size: 26rpx;
  color: #555555;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 模块网格 */
.module-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  padding: 0 20rpx;
}

.module-card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 30rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
  position: relative;
  overflow: hidden;
  min-height: 160rpx;
  transition: transform 0.1s;
}

.module-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 6rpx;
  background: linear-gradient(90deg, #CC0000, #FF6666);
}

.module-card-full {
  grid-column: 1 / -1;
  flex-direction: row;
  justify-content: center;
  gap: 16rpx;
  min-height: 110rpx;
}

.module-icon {
  font-size: 56rpx;
  margin-bottom: 12rpx;
  line-height: 1;
}

.module-card-full .module-icon {
  margin-bottom: 0;
  font-size: 48rpx;
}

.module-name {
  font-size: 26rpx;
  color: #333333;
  font-weight: 500;
  text-align: center;
  line-height: 1.4;
}

.module-card-full .module-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #CC0000;
}

/* 底部 */
.footer-note {
  text-align: center;
  padding: 30rpx;
  color: #AAAAAA;
  font-size: 22rpx;
  margin-top: 10rpx;
}
